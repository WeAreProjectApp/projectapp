{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxi dev",
    "build": "nuxi build",
    "generate": "nuxi generate",
    "build:django": "node update-django-template.js",
    "preview": "nuxi preview",
    "postinstall": "nuxi prepare && npx playwright install chromium",
    "optimize-images": "node scripts/optimize-images.js",
    "test": "NODE_OPTIONS='--no-deprecation' jest --config jest.config.cjs",
    "test:watch": "NODE_OPTIONS='--no-deprecation' jest --config jest.config.cjs --watch",
    "test:coverage": "NODE_OPTIONS='--no-deprecation' jest --config jest.config.cjs --coverage && node scripts/coverage-summary.cjs",
    "e2e": "playwright test",
    "e2e:pwa": "playwright test --config playwright.pwa.config.js",
    "e2e:delivery": "playwright test --config playwright.delivery.config.js",
    "e2e:issues": "playwright test --config playwright.issues.config.js",
    "e2e:responsive": "node scripts/run-responsive-changed.mjs --all",
    "e2e:responsive:batch": "node scripts/run-responsive-changed.mjs",
    "e2e:responsive:changed": "node scripts/run-responsive-changed.mjs",
    "e2e:ui": "playwright test --ui",
    "e2e:coverage": "npm run e2e:clean && playwright test",
    "e2e:clean": "rm -rf e2e-results",
    "check:e2e-flow-sync": "node scripts/check-flow-definitions-sync.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "check:design-tokens:panel": "node scripts/check-design-tokens.mjs --scope=panel",
    "check:design-tokens:strict": "node scripts/check-design-tokens.mjs --strict",
    "check:design-tokens:rows": "node scripts/check-design-tokens.mjs --scope=panel --strict --strict-rows",
    "check:panel-action-icons": "node scripts/check-panel-action-icons.mjs",
    "check:icon-interaction-feedback": "node scripts/check-icon-interaction-feedback.mjs",
    "check:panel-native-dialogs": "node scripts/check-panel-native-dialogs.mjs",
    "check:responsive-contract": "node scripts/check-responsive-contract.mjs",
    "check:disabled-controls": "node scripts/check-disabled-controls.mjs --strict",
    "check:view-catalog": "node scripts/check-view-catalog.mjs",
    "ci:e2e-flow-summary": "node scripts/report-e2e-flow-coverage-ci.mjs",
    "flow:registry": "python3 ../scripts/generate_flow_registry.py --repo-root ..",
    "flow:registry:check": "python3 ../scripts/generate_flow_registry.py --repo-root .. --check"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@vueuse/core": "^14.4.0",
    "apexcharts": "^7.0.0",
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
    "dompurify": "^3.4.14",
    "gsap": "^3.15.0",
    "lottie-web": "^5.13.0",
    "marked": "^18.0.11",
    "overrides": "^1.2.0",
    "pinia": "^4.0.3",
    "plyr": "^3.8.4",
    "qrcode": "^1.5.4",
    "simplex-noise": "^4.0.3",
    "sweetalert2": "^11.26.25",
    "swiper": "^14.2.0",
    "video.js": "^8.24.0",
    "vue3-apexcharts": "^1.11.1",
    "vue3-emoji-picker": "^1.1.8",
    "vue3-lottie": "^3.3.1",
    "vue3-marquee": "^4.2.2",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^1.0.2",
    "@playwright/test": "^1.62.1",
    "@vue/test-utils": "^2.5.0",
    "@vue/vue3-jest": "^29.2.6",
    "babel-jest": "^29.7.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-transform-stub": "^2.0.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "overrides": {
    "serialize-javascript": "7.0.5"
  }
}
